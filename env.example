# Telegram API
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_HELPER_BOT_TOKENS=
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890

# Database (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./data/teleplay.db

# JWT
JWT_SECRET=

# Google Drive
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=http://localhost:7446/api/gdrive/auth/callback

# Proxy (SOCKS5)
MT_PROXY_URL=socks5://telegram:REDACTED_PROXY_PASSWORD@socks5:1080
